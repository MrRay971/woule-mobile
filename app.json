{
  "expo": {
    "name": "Woulé",
    "slug": "woule-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "woule",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131726"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.woule.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Woulé utilise votre position pour enregistrer vos trajets et calculer vos points.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Woulé utilise votre position en arrière-plan pour enregistrer vos trajets en continu.",
        "NFCReaderUsageDescription": "Woulé utilise le NFC pour détecter le tag de votre véhicule et démarrer automatiquement le suivi GPS.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131726",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.woule.mobile",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Woulé utilise votre position pour enregistrer vos trajets.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Détection du tag NFC du véhicule pour démarrer le suivi GPS",
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ]
    ]
  }
}
